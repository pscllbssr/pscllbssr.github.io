---
import { Icon } from 'astro-icon/components';

const ownProjects = [
  {
    title: 'Offbeat Odyssey Newsletter',
    description: 'Jeden Dienstag und Freitag taucht Offbeat Odyssey mit dir in ein neues Musikgenre ein, inklusive Playlist mit den essentiellen Tracks. Jetzt kostenlos Platz sichern: <a href="https://buttondown.com/offbeat-odyssey" target="_blank" rel="noopener noreferrer">buttondown.com/offbeat-odyssey</a>. <br/>Dahinter liegt ein vollautomatisiertes System: KI «recherchiert» Hintergründe und textet den Newsletter gleich selbst.',
    url: 'https://buttondown.com/offbeat-odyssey/archive/',
    isPlaceholder: false
  },
];
---

<section class="own-projects border-top">
  <div class="container">
    <h2>
      <Icon name="mdi:lightbulb" width="28" height="28" />
      Eigene Projekte
    </h2>
    <p class="section-description">
    Neben meiner journalistischen Tätigkeit arbeite ich an verschiedenen Software- und Datenprojekten und experimentiere mit Anwendungsmöglichkeiten generativer KI.    </p>
    <div class="project-list">
      {ownProjects.map((project) => (
        <article class:list={["project-item", { placeholder: project.isPlaceholder }]}>
          <h3>
            {project.isPlaceholder ? (
              <>Demnächst verfügbar: {project.title}</>
            ) : (
              <a href={project.url} target="_blank" rel="noopener noreferrer">
                {project.title}
              </a>
            )}
          </h3>
          <p class="description" set:html={project.description}>
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .own-projects {
    background: var(--color-bg);
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }

  .project-item {
    padding-bottom: var(--spacing-xl);
    border-bottom: 1px solid var(--color-light-gray);
  }

  .project-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .project-item.placeholder {
    opacity: 0.6;
  }

  .project-item.placeholder h3 {
    color: var(--color-gray);
    margin-bottom: var(--spacing-xs);
  }

  .project-item h3 {
    margin-bottom: var(--spacing-xs);
  }

  .description {
    margin-bottom: 0;
    line-height: 1.7;
    color: var(--color-gray);
  }

  @media (max-width: 768px) {
    .project-list {
      gap: var(--spacing-lg);
    }

    .project-item {
      padding-bottom: var(--spacing-lg);
    }
  }
</style>
